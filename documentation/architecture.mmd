    classDef security fill:#211b3d,stroke:#a78bfa,color:#f4f7fb
    classDef runtime fill:#122f32,stroke:#39d4bd,color:#f4f7fb
    classDef observe fill:#3a271d,stroke:#ffae70,color:#f4f7fb
    class DEV,PR,CI source
    class TEST,SAST,SCA,TRIVY security
    class IMAGE,REG,DEPLOY,SERVICE,INGRESS,POLICY,PROBES runtime
